# Willys-inloggning.
# Användarnamn: personnummer (10 eller 12 siffror) ELLER Willys Plus-nummer
# (16 siffror). E-postadress fungerar inte — formuläret skickas aldrig.
WILLYS_USERNAME=
WILLYS_PASSWORD=

# Din butik. Lämna tom tills vidare — slå upp ditt id med verktyget
# willys_find_stores (t.ex. query "Lund" eller ditt postnummer) och fyll i det.
# Krävs bara av willys_get_campaigns; allt annat fungerar utan.
WILLYS_STORE_ID=

# Valfritt
# WILLYS_LOG=debug        # debug | silent
# WILLYS_HEADFUL=1        # visa webbläsaren vid inloggning
# WILLYS_DB_PATH=/annan/sokvag/willys.db
# WILLYS_ENV_FILE=/annan/sokvag/.env
