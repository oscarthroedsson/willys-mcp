{
  "name": "willys-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP-server för Willys: sök, jämför pris, planera veckans recept och fyll kundvagnen från din egen dator.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "claude",
    "willys",
    "matplanering",
    "dagligvaror"
  ],
  "author": "Oscar Throedsson",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "willys-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    ".env.example",
    "INSTALL.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm run build",
    "start": "node dist/index.js",
    "mcp": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx tests/smoke.ts",
    "e2e": "tsx tests/e2e.ts",
    "test:volume": "tsx tests/volume.test.ts",
    "test:product": "tsx tests/product.test.ts",
    "test:pieces": "tsx tests/piece-weights.test.ts",
    "test:names": "tsx tests/name-match.test.ts",
    "test:coverage": "tsx tests/coverage.test.ts",
    "test:planner": "tsx tests/planner.test.ts",
    "test:category": "tsx tests/category.test.ts",
    "test:coop": "tsx tests/coop.test.ts",
    "test:chains": "tsx tests/chains.test.ts",
    "test:releases": "tsx tests/releases.test.ts",
    "kandidater": "tsx scripts/kandidater.ts",
    "veckohandla": "tsx scripts/veckohandla.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "better-sqlite3": "^12.6.2",
    "puppeteer": "^24.35.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.9",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
